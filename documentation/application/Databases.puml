package "payments / PostgreSQL" {
 entity "command_keys" as payments_command_keys {
  id : VARCHAR(255) <<PK>>
  fingerprint : VARCHAR(64)
  response : TEXT
  resource_guid : UUID
  created_at : TIMESTAMPTZ
 }
 entity "state_audit" as payments_audit {
  id : BIGINT <<PK>>
  aggregate_guid : UUID
  old_status : VARCHAR(40)
  new_status : VARCHAR(40)
