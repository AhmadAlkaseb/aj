        <mxCell id="reserved" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4874ac;fontColor=#4874ac;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="reserve" target="claim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="authorised" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4874ac;fontColor=#4874ac;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="claim" target="outcome">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="paid" value="Success" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#388052;fontColor=#388052;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="outcome" target="completed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bad-customer" value="customer.invalid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b94b43;fontColor=#b94b43;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="customer" target="rejected">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="no-stock" value="quantityrejected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b94b43;fontColor=#b94b43;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;entryX=1;entryY=0.5;" edge="1" parent="1" source="reserve" target="rejected">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="310" y="270" />
              <mxPoint x="310" y="465" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="cancel" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b94b43;fontColor=#b94b43;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="reserve" target="cancelled">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="460" y="330" />
              <mxPoint x="610" y="330" />
              <mxPoint x="610" y="395" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="cancel-release" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b94b43;fontColor=#b94b43;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.87;entryY=0;" edge="1" parent="1" source="cancelled" target="release">
          <mxGeometry relative="1" as="geometry">
