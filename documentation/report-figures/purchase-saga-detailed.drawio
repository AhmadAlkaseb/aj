        <mxCell id="available-again" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b94b43;fontColor=#b94b43;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="release" target="available">
          <mxGeometry relative="1" as="geometry">
