            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="compensate" value="Same event to Products" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b94b43;fontColor=#b94b43;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="failed" target="release">
          <mxGeometry relative="1" as="geometry" />
