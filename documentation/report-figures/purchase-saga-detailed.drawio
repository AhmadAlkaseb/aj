        </mxCell>
        <mxCell id="uncertain" value="No confirmed outcome" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b6852a;fontColor=#b6852a;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="outcome" target="review">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1088" y="390" />
              <mxPoint x="1320" y="390" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="reconcile" value="Reconcile / retry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b6852a;fontColor=#b6852a;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="review" target="outcome">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1490" y="525" />
              <mxPoint x="1490" y="160" />
              <mxPoint x="1040" y="160" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="legend" value="Blue: normal flow   •   Green: success / available inventory   •   Red: rejection or compensation   •   Amber: wait and reconcile" style="text;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#42526b;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="645" width="1400" height="35" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Each service commits locally. Compensation releases inventory; it does not erase the failed order or restart it." style="text;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=20;fontColor=#42526b;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="683" width="1400" height="35" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
