<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram name="Reservation and compensation" id="purchase-saga">
    <mxGraphModel page="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Reservation and payment saga" style="text;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=32;fontColor=#42526b;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="1400" height="42" as="geometry" />
        </mxCell>
        <mxCell id="available" value="&lt;b&gt;Car AVAILABLE&lt;/b&gt;&lt;br&gt;Can be reserved again" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e9f5ec;strokeColor=#388052;strokeWidth=2;fontColor=#203047;fontFamily=Arial;fontSize=17;spacing=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="340" y="60" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="customer" value="&lt;b&gt;1. Check customer&lt;/b&gt;&lt;br&gt;Users validates customer&lt;br&gt;Order: PENDING" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#edf4ff;strokeColor=#4874ac;strokeWidth=2;fontColor=#203047;fontFamily=Arial;fontSize=17;spacing=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="reserve" value="&lt;b&gt;2. Reserve car&lt;/b&gt;&lt;br&gt;Products locks this order’s car&lt;br&gt;Order: RESERVED" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#edf4ff;strokeColor=#4874ac;strokeWidth=2;fontColor=#203047;fontFamily=Arial;fontSize=17;spacing=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="340" y="200" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="claim" value="&lt;b&gt;3. Authorise payment&lt;/b&gt;&lt;br&gt;Orders claims reservation&lt;br&gt;Order: PAYMENT_PENDING" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#edf4ff;strokeColor=#4874ac;strokeWidth=2;fontColor=#203047;fontFamily=Arial;fontSize=17;spacing=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="640" y="200" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="outcome" value="&lt;b&gt;Payment&lt;/b&gt;&lt;br&gt;outcome?" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#edf4ff;strokeColor=#4874ac;strokeWidth=2;fontColor=#203047;fontFamily=Arial;fontSize=17;spacing=6;verticalAlign=middle;shape=rhombus;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="960" y="200" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="completed" value="&lt;b&gt;Purchase completed&lt;/b&gt;&lt;br&gt;payment.completed&lt;br&gt;Order: COMPLETED&lt;br&gt;Car: SOLD" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e9f5ec;strokeColor=#388052;strokeWidth=2;fontColor=#203047;fontFamily=Arial;fontSize=17;spacing=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1200" y="200" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rejected" value="&lt;b&gt;Order REJECTED&lt;/b&gt;&lt;br&gt;Invalid customer or car unavailable&lt;br&gt;No reservation to undo" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#b94b43;strokeWidth=2;fontColor=#203047;fontFamily=Arial;fontSize=17;spacing=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cancelled" value="&lt;b&gt;Order CANCELLED&lt;/b&gt;&lt;br&gt;Cancel / unpaid reservation expiry&lt;br&gt;order.cancelled" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#b94b43;strokeWidth=2;fontColor=#203047;fontFamily=Arial;fontSize=17;spacing=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="650" y="350" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="failed" value="&lt;b&gt;Payment failed&lt;/b&gt;&lt;br&gt;Payments emits paymentfail&lt;br&gt;Orders: FAILED" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#b94b43;strokeWidth=2;fontColor=#203047;fontFamily=Arial;fontSize=17;spacing=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="940" y="470" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="release" value="&lt;b&gt;Undo the reservation&lt;/b&gt;&lt;br&gt;Products releases this order’s car&lt;br&gt;RESERVED → AVAILABLE" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#b94b43;strokeWidth=2;fontColor=#203047;fontFamily=Arial;fontSize=17;spacing=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="340" y="470" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;Outcome unknown&lt;/b&gt;&lt;br&gt;After payment deadline:&lt;br&gt;REVIEW_REQUIRED&lt;br&gt;Keep reservation; reconcile" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fff7df;strokeColor=#b6852a;strokeWidth=2;fontColor=#203047;fontFamily=Arial;fontSize=17;spacing=6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1200" y="470" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="validated" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4874ac;fontColor=#4874ac;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="customer" target="reserve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="stock" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#388052;fontColor=#388052;fontFamily=Arial;fontSize=18;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="available" target="reserve">
          <mxGeometry relative="1" as="geometry" />
