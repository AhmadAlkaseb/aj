  "x-topology": {
    "exchange": "aj.events",
    "type": "topic",
    "durable": true,
    "deadLetterExchange": "aj.dead",
    "deadLetterQueue": "aj.dead",
    "queues": {
      "users": {
        "queue": "aj.users",
        "routingKeys": [
          "customer.check"
        ],
        "manualAck": true
      },
      "products": {
        "queue": "aj.products",
        "routingKeys": [
          "quantitycheck",
          "order.cancelled",
          "payment.completed",
          "paymentfail"
        ],
        "manualAck": true
      },
      "orders": {
        "queue": "aj.orders",
        "routingKeys": [
          "customer.valid",
          "customer.invalid",
          "quantityreserved",
          "quantityrejected",
          "payment.requested",
          "payment.completed",
          "paymentfail"
        ],
        "manualAck": true
      },
      "payments": {
        "queue": "aj.payments",
        "routingKeys": [
          "payment.authorized",
          "payment.rejected",
          "order.owner",
          "payment.reconcile"
        ],
        "manualAck": true
      },
      "product-synchronizer": {
        "queue": "aj.product-sync",
        "routingKeys": [
          "product.created",
          "product.updated",
          "product.reserved",
          "product.removed"
        ],
        "manualAck": true
      },
      "confirmation-job": {
        "queue": "aj.confirmations",
        "routingKeys": [
          "order.completed"
        ],
        "manualAck": true
      }
    }
  }
