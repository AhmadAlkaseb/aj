                "enum": [
                  "payment.requested"
                ]
              },
              "occurredAt": {
                "type": "string",
                "format": "date-time"
              },
              "correlationId": {
                "type": "string",
                "format": "uuid"
              },
              "schemaVersion": {
                "type": "integer",
                "enum": [
                  1
                ]
              },
              "payload": {
                "type": "object",
                "properties": {
                  "orderGuid": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "paymentGuid": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "orderGuid",
                  "paymentGuid"
