            },
            "required": [
              "eventId",
              "eventType",
              "occurredAt",
              "correlationId",
              "schemaVersion",
              "payload"
            ]
          },
          "correlationId": {
            "location": "$message.payload#/correlationId"
          }
        }
      }
    },
