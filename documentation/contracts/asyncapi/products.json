      "subscribe": {
        "message": {
          "name": "quantitycheck",
          "contentType": "application/json",
          "payload": {
            "type": "object",
            "properties": {
              "eventId": {
                "type": "string",
                "format": "uuid"
              },
              "eventType": {
                "type": "string",
                "enum": [
                  "quantitycheck"
                ]
              },
              "occurredAt": {
                "type": "string",
                "format": "date-time"
              },
              "correlationId": {
                "type": "string",
                "format": "uuid"
              },
              "schemaVersion": {
                "type": "integer",
                "enum": [
                  1
                ]
              },
              "payload": {
                "type": "object",
                "properties": {
                  "orderGuid": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "userGuid": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "productGuid": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "totalAmount": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 9999999999.99,
                        "multipleOf": 0.01
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "currency": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "orderGuid",
                  "userGuid",
                  "productGuid",
                  "totalAmount",
                  "currency"
                ]
              }
            },
            "required": [
              "eventId",
              "eventType",
              "occurredAt",
              "correlationId",
              "schemaVersion",
              "payload"
            ]
          },
          "correlationId": {
            "location": "$message.payload#/correlationId"
          }
        }
      }
    },
