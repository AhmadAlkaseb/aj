# CI promotes the checksummed JAR from the successful service validation pipeline.
FROM eclipse-temurin:22-jre-jammy
ARG SERVICE
WORKDIR /app
RUN groupadd --system aj && useradd --system --gid aj aj
COPY ${SERVICE}-application/app.jar /app/app.jar
USER aj
ENV PORT=7000
EXPOSE 7000
HEALTHCHECK --interval=10s --timeout=8s --start-period=40s --retries=3 CMD ["java", "-cp", "/app/app.jar", "com.aj.common.HealthProbe"]
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=70", "-jar", "/app/app.jar"]
