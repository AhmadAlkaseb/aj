        "content": "<div style=\"border-top:3px solid #5794f2;padding:18px 12px\"><p style=\"margin:0 0 18px 0\"><a style=\"font-size:18px;font-weight:600;color:#5794f2\" href=\"http://localhost:18080/?pgsql=users-db&amp;username=admin&amp;db=users\" target=\"_blank\" rel=\"noopener noreferrer\">Users \u2197</a><br><span style=\"color:#a6adbb\">Kunder og inbox/outbox</span></p><p style=\"margin:0 0 18px 0\"><a style=\"font-size:18px;font-weight:600;color:#5794f2\" href=\"http://localhost:18080/?pgsql=products-db&amp;username=admin&amp;db=products\" target=\"_blank\" rel=\"noopener noreferrer\">Products \u2197</a><br><span style=\"color:#a6adbb\">Biler, priser og reservationer</span></p><p style=\"margin:0 0 18px 0\"><a style=\"font-size:18px;font-weight:600;color:#5794f2\" href=\"http://localhost:18080/?pgsql=orders-db&amp;username=admin&amp;db=orders\" target=\"_blank\" rel=\"noopener noreferrer\">Orders \u2197</a><br><span style=\"color:#a6adbb\">Ordrer, historik og PDF</span></p><p style=\"margin:0 0 18px 0\"><a style=\"font-size:18px;font-weight:600;color:#5794f2\" href=\"http://localhost:18080/?pgsql=payments-db&amp;username=admin&amp;db=payments\" target=\"_blank\" rel=\"noopener noreferrer\">Payments \u2197</a><br><span style=\"color:#a6adbb\">Betalinger og audit</span></p><p style=\"margin:0 0 18px 0\"><a style=\"font-size:18px;font-weight:600;color:#5794f2\" href=\"http://localhost:18080/?pgsql=keycloak-db&amp;username=admin&amp;db=keycloak\" target=\"_blank\" rel=\"noopener noreferrer\">Keycloak DB \u2197</a><br><span style=\"color:#a6adbb\">Identitetsdatabasen</span></p></div>"
