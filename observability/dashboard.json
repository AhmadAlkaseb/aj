{
  "uid": "aj-platform",
  "title": "AJ Motors operations",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aj-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(service)(rate(aj_http_requests_total[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "P95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aj-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le,service)(rate(aj_http_duration_seconds_bucket[1m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aj-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(service)(rate(aj_http_requests_total{status=~\"5..\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Oldest outbox message",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aj-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "aj_outbox_oldest_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Pending outbox",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aj-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "aj_outbox_pending",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "RabbitMQ ready messages",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aj-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rabbitmq_queue_messages_ready",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Dead letters",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aj-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rabbitmq_queue_messages{queue=\"aj.dead\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Dependencies",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aj-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "up",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Projection delivery lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aj-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "aj_projection_lag_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Application logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "aj-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 12
      },
      "options": {
        "showTime": true,
        "showCommonLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{project=\"aj\"}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }
  ],
  "links": [
    {
      "title": "\u2302 Control Center",
      "type": "link",
      "url": "/d/aj-home",
      "icon": "home",
      "targetBlank": false
    }
  ]
}
