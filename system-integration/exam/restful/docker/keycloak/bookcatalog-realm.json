{
  "realm": "bookcatalog",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "book-api",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:7070/api/v1/auth/callback",
        "https://oauth.pstmn.io/v1/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "use.refresh.tokens": "false",
        "post.logout.redirect.uris": "http://localhost:7070/api/v1/auth"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "book-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "firstName": "Demo",
      "lastName": "User",
      "email": "demo@example.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demopass",
          "temporary": false
        }
      ]
    }
  ]
}
