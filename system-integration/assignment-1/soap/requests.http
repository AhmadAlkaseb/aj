###
### ConflictFault - opret først en bog med authorId=1, og kør derefter denne request
POST {{baseUrl}}
Content-Type: {{contentType}}
SOAPAction: "DeleteAuthor"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
               xmlns:lib="http://soap.example.org/library">
    <soap:Body>
        <lib:deleteAuthorRequest>
            <lib:id>1</lib:id>
        </lib:deleteAuthorRequest>
    </soap:Body>
</soap:Envelope>

