@baseUrl = http://localhost:8080/services/library
@contentType = text/xml; charset=utf-8

### Hent WSDL-kontrakten
GET {{baseUrl}}?wsdl

###
### Opret en forfatter - forventet succes, genereret ID = 1 ved frisk serverstart
POST {{baseUrl}}
Content-Type: {{contentType}}
SOAPAction: "CreateAuthor"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
               xmlns:lib="http://soap.example.org/library">
    <soap:Body>
        <lib:createAuthorRequest>
            <lib:name>Hans</lib:name>
            <lib:surname>Hansen</lib:surname>
        </lib:createAuthorRequest>
    </soap:Body>
</soap:Envelope>

###
### Opret et forlag - forventet succes, genereret ID = 2 ved frisk serverstart
POST {{baseUrl}}
Content-Type: {{contentType}}
SOAPAction: "CreatePublishingCompany"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
               xmlns:lib="http://soap.example.org/library">
    <soap:Body>
        <lib:createPublishingCompanyRequest>
            <lib:name>Eksempel Forlag</lib:name>
        </lib:createPublishingCompanyRequest>
    </soap:Body>
</soap:Envelope>

###
### Opret en bog - forventet succes, genereret ID = 3 ved frisk serverstart
POST {{baseUrl}}
Content-Type: {{contentType}}
SOAPAction: "CreateBook"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
               xmlns:lib="http://soap.example.org/library">
    <soap:Body>
        <lib:createBookRequest>
            <lib:title>SOAP med Apache CXF</lib:title>
            <lib:authorId>1</lib:authorId>
            <lib:publishingCompanyId>2</lib:publishingCompanyId>
            <lib:publishingYear>2024</lib:publishingYear>
        </lib:createBookRequest>
    </soap:Body>
</soap:Envelope>

###
### Hent bog med ID 3 - forventet succes
POST {{baseUrl}}
Content-Type: {{contentType}}
SOAPAction: "GetBookById"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
               xmlns:lib="http://soap.example.org/library">
    <soap:Body>
        <lib:getBookByIdRequest>
            <lib:id>3</lib:id>
        </lib:getBookByIdRequest>
    </soap:Body>
</soap:Envelope>

###
### Opdater bog 3 - forventet succes
POST {{baseUrl}}
Content-Type: {{contentType}}
SOAPAction: "UpdateBook"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
               xmlns:lib="http://soap.example.org/library">
    <soap:Body>
        <lib:updateBookRequest>
            <lib:id>3</lib:id>
            <lib:title>Opdateret SOAP-bog</lib:title>
            <lib:authorId>1</lib:authorId>
            <lib:publishingCompanyId>2</lib:publishingCompanyId>
            <lib:publishingYear>2025</lib:publishingYear>
        </lib:updateBookRequest>
    </soap:Body>
</soap:Envelope>

###
### Slet bog 3 - forventet succes
POST {{baseUrl}}
Content-Type: {{contentType}}
SOAPAction: "DeleteBook"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
               xmlns:lib="http://soap.example.org/library">
    <soap:Body>
        <lib:deleteBookRequest>
            <lib:id>3</lib:id>
        </lib:deleteBookRequest>
    </soap:Body>
</soap:Envelope>

